# Kopie dieser Datei als .env anlegen und anpassen.
# Alle Werte sind optional – ohne .env gelten die hier gezeigten Vorgaben.

# Port des Servers im Heimnetz
PORT=4000

# 0.0.0.0 macht den Server für alle Geräte im Heimnetz erreichbar.
# 127.0.0.1 beschränkt ihn auf den Rechner selbst.
HOST=0.0.0.0

# Ablage von Datenbank und Sicherungen (relativ zum Projektordner oder absolut)
DATABASE_FILE=data/warensystem.db
BACKUP_DIR=data/backups

# HTTPS: auto = einschalten, sobald ein Zertifikat vorliegt (npm run cert)
#        on   = erzwingen, Start bricht ohne Zertifikat ab
#        off  = immer HTTP (Barcode-Scanner bleibt auf iOS gesperrt)
TLS_MODE=auto
TLS_KEY_FILE=certs/server.key
TLS_CERT_FILE=certs/server.crt

# Vorwarnzeit für Mindesthaltbarkeitsdaten in Tagen.
# Lässt sich auch in der App unter Einstellungen ändern.
EXPIRY_WARN_DAYS=5

# Produktnamen zu gescannten Barcodes bei Open Food Facts nachschlagen.
# false: die gescannte Nummer verlässt das Heimnetz nie.
OFF_ENABLED=true
