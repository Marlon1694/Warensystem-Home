{
  "name": "warensystem-home",
  "version": "1.0.0",
  "private": true,
  "description": "Warenwirtschaft für den Haushalt: Lebensmittel, Bestände und Mindesthaltbarkeit für Kühlschrank, Gefrierfach, Keller und Küche.",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace web",
    "build:demo": "node scripts/build-demo.mjs",
    "start": "npm run start --workspace server",
    "test": "npm run test --workspace server",
    "typecheck": "npm run typecheck --workspace web",
    "cert": "node scripts/generate-cert.mjs",
    "seed": "node server/src/db/seed.js"
  }
}
