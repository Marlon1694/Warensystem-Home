# Dienstvorlage für Warensystem Home.
#
# deploy/install.sh setzt die Platzhalter ein und legt die Datei unter
# /etc/systemd/system/warensystem-home.service ab. Für eine Installation von
# Hand die drei Platzhalter selbst ersetzen:
#
#   __APP_USER__   Benutzer, unter dem der Dienst läuft   (z. B. warensystem)
#   __APP_DIR__    Verzeichnis mit dem Quellcode          (z. B. /opt/warensystem-home)
#   __DATA_DIR__   Verzeichnis für Datenbank und Backups  (z. B. /var/lib/warensystem-home)
#
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now warensystem-home

[Unit]
Description=Warensystem Home – Haushalts-Warenwirtschaft
Documentation=https://github.com/Marlon1694/Warensystem-Home
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__APP_USER__
Group=__APP_USER__
WorkingDirectory=__APP_DIR__
EnvironmentFile=-__APP_DIR__/.env
ExecStart=/usr/bin/node server/src/index.js
Restart=always
RestartSec=5

# Der Dienst schreibt ausschließlich in sein Datenverzeichnis.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=__DATA_DIR__

[Install]
WantedBy=multi-user.target
